<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Disable IIS native WebSocket handler so ARR can proxy WebSocket upgrades
             (wss://host/ws/order-scan) to the Node.js process.
             Without this, IIS intercepts the Upgrade request and ARR never sees it. -->
        <webSocket enabled="false" />

        <!-- Disable response buffering so scan events stream through immediately -->
        <urlCompression doDynamicCompression="false" doStaticCompression="false" />

        <rewrite>
            <rules>
                <!-- WebSocket upgrade rule — MUST come before the HTTP catch-all.
                     The {HTTP_UPGRADE} condition matches "Upgrade: websocket" headers,
                     telling ARR to proxy this as a WebSocket connection rather than a
                     regular HTTP request. Without this explicit rule, ARR may buffer
                     or reject the upgrade handshake. -->
                <rule name="WebSocketProxy" stopProcessing="true">
                    <match url="^ws/order-scan$" />
                    <conditions>
                        <add input="{HTTP_UPGRADE}" pattern="websocket" ignoreCase="true" />
                    </conditions>
                    <action type="Rewrite" url="http://localhost:6000/ws/order-scan" />
                </rule>

                <!-- All other HTTP requests: reverse-proxy to Node.js.
                     Port must match the PORT your Node.js/PM2 process listens on (6000 in production). -->
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:6000/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
