<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Disable IIS native WebSocket handler so ARR can proxy WebSocket upgrades
             (wss://host/ws/order-scan) to the Node.js process.
             Without this, IIS intercepts the upgrade and ARR never forwards it. -->
        <webSocket enabled="false" />

        <!-- Disable response buffering so scan events stream through immediately -->
        <urlCompression doDynamicCompression="false" doStaticCompression="false" />

        <rewrite>
            <rules>
                <!-- Port MUST match the PORT value in your .env file (currently PORT=5001).
                     If you change PORT in .env, update localhost:5001 here to match. -->
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:5001/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
